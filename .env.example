# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Required only for the Auto Review & Revise Draft feature.
# Configure this server-side in .env; never expose it with a VITE_ prefix.
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Firebase web-app settings. These override firebase-applet-config.json.
# Copy this file to .env.local and fill these from the existing Firebase app config
# when you want to keep environment-specific configuration out of source control.
# VITE_ values are included in browser code; they are public app configuration,
# never put private credentials or service-account keys here.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
